# Copy outside the repository, replace every placeholder, and chmod the secret
# inputs mode 0400. Leave the files owned by the operator: separate networkless
# one-shot ingress services copy the URLs and PostgreSQL password into private
# mode-0400 runtime volumes owned by their consuming UIDs (10001 and 70).
NEROCD_IMAGE=registry.example.invalid/nerocd@sha256:<replace-with-64-lowercase-hex-digest>
NEROCD_PROXY_NETWORK=nerocd-production-proxy
NEROCD_PUBLIC_ORIGIN=https://nerocd.example.invalid
# Optional comma-separated CIDRs for the immediately connected reverse proxy.
# Leave empty unless the proxy injects X-Forwarded-For; client headers are
# ignored otherwise.
NEROCD_TRUSTED_PROXY_CIDRS=
# Distinct PostgreSQL LOGIN role names. The owner owns migrations; role-init
# creates the app role with DML-only grants.
NEROCD_OWNER_DATABASE_USER=nerocd_owner_replace_me
NEROCD_APP_DATABASE_USER=nerocd_app_replace_me
NEROCD_DATABASE_URL_SECRET=/absolute/path/to/database-url-secret
NEROCD_APP_DATABASE_URL_SECRET=/absolute/path/to/application-database-url-secret
NEROCD_POSTGRES_PASSWORD_SECRET=/absolute/path/to/postgres-password-secret
# The local owner-only scheduler is deliberately opt-in. It writes only the
# private `backup-data` named volume; arrange an approved local retrieval
# procedure separately. It never uploads, encrypts, or deletes database data.
NEROCD_BACKUP_SCHEDULE_ENABLED=false
NEROCD_BACKUP_INTERVAL_SECONDS=86400
NEROCD_BACKUP_RETENTION_COUNT=7
