FROM alpine:3.22.2@sha256:4b7ce07002c69e8f3d704a9c5d6fd3053be500b7f1c69fc0d80990c2ad8dd412
RUN apk add --no-cache git openssh-client openssh-keygen openssh-server \
 && command -v ssh ssh-keyscan sshd git
RUN adduser -D -H -u 10002 -h /git/home -s /bin/sh git \
 && passwd -d git
RUN ln -s /git/repo.git /repo.git
