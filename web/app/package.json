{
  "name": "@nerocd/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.6",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "smoke:browser": "NEROCD_BROWSER_SMOKE_PORT=$(node -e 'process.stdout.write(String(20000 + Math.floor(Math.random() * 10000)))') playwright test --config playwright.config.ts",
    "api:generate": "openapi-typescript ../../openapi.yaml -o src/api/generated.ts",
    "api:check": "sh -ec 'tmp=$(mktemp); trap \"rm -f $tmp\" EXIT; openapi-typescript ../../openapi.yaml -o $tmp; diff -u src/api/generated.ts $tmp'",
    "routes:generate": "vite build --emptyOutDir false",
    "routes:check": "sh -ec 'tmp=$(mktemp); trap \"cp $tmp src/routeTree.gen.ts; rm -f $tmp\" EXIT; cp src/routeTree.gen.ts $tmp; vite build --emptyOutDir false >/dev/null; diff -u $tmp src/routeTree.gen.ts'",
    "test": "vitest run",
    "policy": "node scripts/check-dependencies.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-router": "1.170.31",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/router-plugin": "1.168.34",
    "@testing-library/react": "16.3.1",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.10.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
